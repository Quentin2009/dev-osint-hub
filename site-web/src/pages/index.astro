---
// Importation du CSS Tailwind
import '../styles/global.css';

// Importation des données
import toolsData from '../data/tools.json';

// Fonction de nettoyage
const sanitizeText = (txt: string) => {
  if (!txt) return '';
  return txt
    .replace(/\[↑\]\(#-table-of-contents\)/gi, '')
    .replace(/\[↑\]\(#.*?\)/gi, '')
    .replace(/\[\^.*?\]/g, '')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .trim();
};

// Enrichissement et nettoyage des données côté serveur
const enrichedTools = toolsData.map((tool: any, index: number) => {
  const rawDesc = tool.description || tool.safeDesc || 'Pas de description disponible.';
  return {
    id: tool.id || index + 1,
    title: sanitizeText(tool.title || tool.name || 'Outil sans nom'),
    url: tool.url || '#',
    source: tool.source || 'free_for_dev',
    cleanCategory: sanitizeText(tool.category || tool.cleanCategory || 'Général'),
    pricing: tool.pricing || 'Gratuit',
    safeDesc: sanitizeText(rawDesc),
    requiresApi: tool.requiresApi || false,
    cheatSheet: tool.cheatSheet || '',
    appType: tool.appType || (tool.requiresApi ? 'API' : 'Web'),
  };
});

const totalCount = enrichedTools.length;
const freeDevTools = enrichedTools.filter((t: any) => t.source === 'free_for_dev');
const osintTools = enrichedTools.filter((t: any) => t.source === 'awesome_osint');

const freeDevCount = freeDevTools.length;
const osintCount = osintTools.length;
const categoriesCount = new Set(enrichedTools.map((t: any) => t.cleanCategory)).size;

const freeDevPct = Math.round((freeDevCount / totalCount) * 100) || 0;
const osintPct = Math.round((osintCount / totalCount) * 100) || 0;

const freeDevCategories = [...new Set(freeDevTools.map((t: any) => t.cleanCategory))].sort();
const osintCategories = [...new Set(osintTools.map((t: any) => t.cleanCategory))].sort();

// 📜 PLAYBOOKS DATA
// Note : J'ai ajouté un tableau "toolIds" (met les vrais IDs de ton tools.json)
const playbooks = [
  {
    id: 'homelab-proxmox',
    icon: '🖥️',
    title: 'Déployer un Homelab Multi-VM',
    description: 'Architecture isolée pour héberger vos services proprement et de manière sécurisée.',
    toolIds: [1, 2, 3], // Remplace par les IDs de Proxmox, Debian, Docker, Caddy, etc.
    steps: [
      { step: 1, title: 'Virtualisation de base', desc: 'Installer Proxmox et configurer vos premières machines virtuelles Debian.', tags: ['Self-Hosted', 'CLI'] },
      { step: 2, title: 'Proxy & Sécurité', desc: 'Déployer Caddy en tant que reverse proxy global pour gérer vos certificats SSL.', tags: ['Web', 'CLI'] },
      { step: 3, title: 'Services & Conteneurs', desc: 'Monter Gitea et Nextcloud via des conteneurs Docker sur des VMs dédiées.', tags: ['Self-Hosted'] }
    ]
  },
  {
    id: 'tiktok-growth',
    icon: '📱',
    title: 'La Méthode Raccourcis pour percer sur TikTok',
    description: 'Automatisation de la création de contenu et hack de croissance.',
    toolIds: [4, 5], // Remplace par les IDs de Dify.ai et Blow Up
    steps: [
      { step: 1, title: 'Génération de scripts IA', desc: 'Créer un workflow rapide et gratuit sur Dify.ai pour convertir des idées en scripts viraux.', tags: ['API', 'Web'] },
      { step: 2, title: 'Propulsion et Croissance', desc: 'Utiliser Blow Up pour faire percer vos comptes TikTok rapidement.', tags: ['Web'] }
    ]
  },
  {
    id: 'osint-investigation',
    icon: '🕵️',
    title: 'Enquête OSINT sur un pseudo',
    description: 'Méthodologie complète pour traquer une identité numérique à travers le web.',
    toolIds: [6, 7], // Remplace par les IDs de tes outils OSINT favoris (ex: Sherlock, Holehe)
    steps: [
      { step: 1, title: 'Recherche d\'alias', desc: 'Vérifier la disponibilité du pseudo sur des centaines de plateformes.', tags: ['CLI', 'Web'] },
      { step: 2, title: 'Analyse d\'empreinte', desc: 'Extraire les métadonnées et récupérer les adresses emails compromises.', tags: ['API'] }
    ]
  }
];
---

<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dev & OSINT Vault | Outils & Playbooks</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  </head>
  <body class="bg-[#090d16] text-slate-100 min-h-screen font-sans antialiased selection:bg-blue-500 selection:text-white pb-20">

    <header class="w-full border-b border-slate-800/80 bg-[#090d16]/90 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-white tracking-tight">
          <span class="text-amber-500 text-2xl">⚡</span>
          <span>Vault<span class="text-cyan-400">.dev</span></span>
        </a>

        <nav class="hidden md:flex items-center gap-4 text-sm font-medium text-slate-300">
          <button data-source="ALL" data-cat="ALL" class="nav-filter-btn hover:text-white transition">Tout afficher</button>

          <div class="relative group">
            <button data-source="free_for_dev" data-cat="ALL" class="nav-filter-btn flex items-center gap-1.5 hover:text-white transition py-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
              Free Dev <span class="text-xs opacity-60">▾</span>
            </button>
            <div class="absolute top-full left-0 hidden group-hover:block group-focus-within:block w-64 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl p-2 z-50 max-h-80 overflow-y-auto">
              <button data-source="free_for_dev" data-cat="ALL" class="nav-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 text-emerald-400 font-semibold mb-1">Tous les outils Free Dev</button>
              <div class="border-t border-slate-800 my-1"></div>
              {freeDevCategories.map((cat: string) => (
                <button data-source="free_for_dev" data-cat={cat} class="nav-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 text-slate-300 transition truncate block">{cat}</button>
              ))}
            </div>
          </div>

          <div class="relative group">
            <button data-source="awesome_osint" data-cat="ALL" class="nav-filter-btn flex items-center gap-1.5 hover:text-white transition py-2">
              <span class="w-2 h-2 rounded-full bg-purple-400 inline-block"></span>
              OSINT <span class="text-xs opacity-60">▾</span>
            </button>
            <div class="absolute top-full left-0 hidden group-hover:block group-focus-within:block w-64 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl p-2 z-50 max-h-80 overflow-y-auto">
              <button data-source="awesome_osint" data-cat="ALL" class="nav-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 text-purple-400 font-semibold mb-1">Tous les outils OSINT</button>
              <div class="border-t border-slate-800 my-1"></div>
              {osintCategories.map((cat: string) => (
                <button data-source="awesome_osint" data-cat={cat} class="nav-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-slate-800 text-slate-300 transition truncate block">{cat}</button>
              ))}
            </div>
          </div>

          <div class="h-4 w-px bg-slate-800 mx-2"></div>

          <!-- BOUTON FAVORIS (Corrigé) -->
          <button id="btn-fav-toggle" class="flex items-center gap-1.5 hover:text-amber-400 transition text-xs font-semibold">
            ⭐ Favoris <span id="fav-badge" class="px-1.5 py-0.5 rounded-full bg-slate-800 text-slate-300">0</span>
          </button>
          
          <button id="btn-stack-toggle" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-900/30 border border-blue-800/50 text-blue-400 hover:bg-blue-900/50 transition text-xs font-semibold">
            📦 Ma Stack <span id="stack-badge" class="px-1.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300">0</span>
          </button>
        </nav>

        <div class="flex items-center gap-3">
          <!-- BOUTON SURPRISE -->
          <button id="btn-surprise-nav" class="px-3 py-2 text-xs font-semibold text-slate-200 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl transition flex items-center gap-1.5" title="Découvrir un outil au hasard">
            <span>🎲</span> <span class="hidden sm:inline">Surprenez-moi !</span>
          </button>
          <button id="open-suggest-modal" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-xl shadow-lg shadow-blue-600/30 transition flex items-center gap-2">
            <span>+</span> Suggérer
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <section class="pt-6 pb-8 text-center max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4">
          Dev & OSINT <span class="bg-gradient-to-r from-teal-300 via-cyan-400 to-blue-400 bg-clip-text text-transparent">Vault</span>
        </h1>
        <p class="text-slate-400 text-base sm:text-lg mb-8 max-w-2xl mx-auto">
          Trouvez instantanément les meilleures ressources gratuites, concevez votre stack et suivez nos playbooks pas-à-pas.
        </p>

        <div class="max-w-2xl mx-auto relative mb-10" id="search-container">
          <input type="text" id="search-input" placeholder="🔍 Rechercher un outil (ex: github, geoloc, cyber)..." class="w-full pl-5 pr-16 py-3.5 rounded-2xl bg-slate-900/90 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition shadow-xl text-sm sm:text-base"/>
          <button id="trigger-palette" class="absolute right-3 top-3 px-2 py-1 text-xs font-mono bg-slate-800 hover:bg-slate-700 text-slate-400 border border-slate-700 rounded-lg transition hidden sm:inline-block cursor-pointer" title="Raccourci de recherche">⌘K</button>
        </div>

        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 shadow-2xl backdrop-blur-sm mb-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-slate-900/80 border border-slate-800/90 rounded-xl p-4 text-center">
              <div id="counter-num" class="text-3xl font-extrabold text-white mb-1">{totalCount}</div>
              <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Ressources Total</div>
            </div>
            <div class="bg-emerald-950/20 border border-emerald-900/40 rounded-xl p-4 text-center">
              <div class="text-3xl font-extrabold text-emerald-400 mb-1">{freeDevCount}</div>
              <div class="text-xs font-medium text-emerald-400/80 uppercase tracking-wider">Free Dev</div>
            </div>
            <div class="bg-purple-950/20 border border-purple-900/40 rounded-xl p-4 text-center">
              <div class="text-3xl font-extrabold text-purple-400 mb-1">{osintCount}</div>
              <div class="text-xs font-medium text-purple-400/80 uppercase tracking-wider">OSINT</div>
            </div>
            <div class="bg-slate-900/80 border border-slate-800/90 rounded-xl p-4 text-center">
              <div class="text-3xl font-extrabold text-slate-200 mb-1">{categoriesCount}</div>
              <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Catégories</div>
            </div>
          </div>
          <div class="space-y-2">
            <div class="flex justify-between text-xs font-semibold px-1">
              <span class="text-emerald-400">Free Dev ({freeDevPct}%)</span>
              <span class="text-purple-400">OSINT ({osintPct}%)</span>
            </div>
            <div class="h-2 w-full bg-slate-950 rounded-full overflow-hidden flex p-0.5 border border-slate-800">
              <div class="bg-emerald-400 h-full rounded-l-full" style={`width: ${freeDevPct}%`}></div>
              <div class="bg-purple-500 h-full rounded-r-full" style={`width: ${osintPct}%`}></div>
            </div>
          </div>
        </div>

        <!-- TABS SELECTOR -->
        <div class="flex items-center justify-center gap-2 mb-4 bg-slate-900/50 p-1.5 rounded-xl border border-slate-800 inline-flex mx-auto">
          <button id="tab-tools" class="tab-btn active px-6 py-2.5 rounded-lg text-sm font-semibold transition-all bg-slate-800 text-white shadow-sm border border-slate-700">
            🛠️ Catalogue d'Outils
          </button>
          <button id="tab-playbooks" class="tab-btn px-6 py-2.5 rounded-lg text-sm font-semibold transition-all hover:bg-slate-800 hover:text-white text-slate-400 border border-transparent">
            📜 Playbooks & Workflows
          </button>
        </div>
      </section>

      <!-- SECTION: CATALOGUE D'OUTILS -->
      <section id="section-tools">
        <div class="flex flex-col gap-4 mb-8 bg-slate-900/30 p-4 rounded-2xl border border-slate-800/50">
          <div class="flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2">Domaine :</span>
              <button data-source="ALL" data-cat="ALL" class="quick-chip active px-3.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800 border border-slate-700 text-slate-200 transition">Tout</button>
              <button data-source="free_for_dev" data-cat="ALL" class="quick-chip px-3.5 py-1.5 rounded-lg text-xs font-medium bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 transition">💻 Free Dev</button>
              <button data-source="awesome_osint" data-cat="ALL" class="quick-chip px-3.5 py-1.5 rounded-lg text-xs font-medium bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 transition">🕵️ OSINT</button>
            </div>
            <select id="sort-select" class="bg-slate-900 border border-slate-800 text-slate-300 text-xs rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="default">Tri par défaut</option>
              <option value="az">Nom (A ➔ Z)</option>
              <option value="za">Nom (Z ➔ A)</option>
            </select>
          </div>

          <div class="h-px w-full bg-slate-800/60"></div>

          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2">Environnement :</span>
            <button data-deploy="ALL" class="deploy-chip active px-3 py-1 rounded-full text-xs font-medium bg-blue-900/30 border border-blue-800/50 text-blue-300 transition">Tous</button>
            <button data-deploy="Web" class="deploy-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 transition">🌐 Web</button>
            <button data-deploy="CLI" class="deploy-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 transition">💻 CLI</button>
            <button data-deploy="Self-Hosted" class="deploy-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 transition">🏠 Self-Hosted</button>
            <button data-deploy="API" class="deploy-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 transition">🔑 API Requise</button>
          </div>
        </div>

        <div id="active-filter-indicator" class="hidden mb-6 flex items-center justify-between p-3 bg-blue-950/40 border border-blue-800/40 rounded-xl text-xs text-blue-300">
          <span>Filtre actif : <strong id="filter-name-text"></strong></span>
          <button id="reset-filter-btn" class="underline hover:text-white">Réinitialiser</button>
        </div>

        <div id="tools-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {enrichedTools.map((tool: any) => (
            <div class="tool-card group relative flex flex-col justify-between p-5 bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-slate-700 rounded-2xl transition duration-200 shadow-sm hover:shadow-md cursor-pointer" data-id={tool.id}>
              <div>
                <div class="flex items-start justify-between gap-3 mb-3">
                  <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700/50">{tool.cleanCategory}</span>
                  <div class="flex items-center gap-1">
                    <button class="fav-btn p-1 hover:text-yellow-400 text-slate-600 transition" data-id={tool.id} title="Favoris">⭐</button>
                    <button class="stack-btn p-1 hover:text-blue-400 text-slate-600 transition" data-id={tool.id} title="Ajouter à la stack">📦</button>
                  </div>
                </div>
                <h3 class="font-semibold text-slate-100 text-base group-hover:text-blue-400 transition mb-2">{tool.title}</h3>
                <p class="text-xs text-slate-400 line-clamp-2 mb-4 leading-relaxed">{tool.safeDesc}</p>
              </div>
              <div class="flex items-center justify-between pt-3 border-t border-slate-800/60 text-xs">
                <div class="flex items-center gap-2">
                  <span class="text-slate-500 font-mono">{tool.pricing}</span>
                  {tool.appType && <span class="text-[10px] bg-slate-800 px-1.5 rounded text-slate-400">{tool.appType}</span>}
                </div>
                <a href={tool.url} target="_blank" rel="noopener noreferrer" class="visit-btn px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700/60 transition">Visiter ↗</a>
              </div>
            </div>
          ))}
        </div>

        <div id="load-more-container" class="mt-12 text-center flex flex-col items-center gap-3">
          <button id="load-more-btn" class="px-8 py-3.5 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-slate-200 font-semibold text-sm rounded-2xl transition flex items-center gap-2">
            <span>⚡</span> <span>Charger plus d'outils</span>
          </button>
          <span id="load-more-info" class="text-xs text-slate-500 font-mono">Affichage de 0 sur 0 outils</span>
        </div>
      </section>

      <!-- SECTION: PLAYBOOKS & WORKFLOWS -->
      <section id="section-playbooks" class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {playbooks.map((playbook: any) => (
            <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl flex flex-col h-full shadow-lg">
              <div class="text-3xl mb-4 bg-slate-800/50 w-12 h-12 flex items-center justify-center rounded-xl border border-slate-700/50">{playbook.icon}</div>
              <h3 class="text-xl font-bold text-white mb-2">{playbook.title}</h3>
              <p class="text-sm text-slate-400 mb-6 flex-grow">{playbook.description}</p>
              
              <div class="space-y-4 border-t border-slate-800/80 pt-4">
                {playbook.steps.map((step: any) => (
                  <div class="relative pl-6 before:absolute before:left-2 before:top-2 before:bottom-[-16px] last:before:bottom-0 before:w-px before:bg-slate-700">
                    <div class="absolute left-0 top-1 w-4 h-4 rounded-full bg-slate-800 border-2 border-blue-500 flex items-center justify-center text-[8px] font-bold text-white">{step.step}</div>
                    <h4 class="text-sm font-semibold text-slate-200 mb-1">{step.title}</h4>
                    <p class="text-xs text-slate-400 mb-2">{step.desc}</p>
                    <div class="flex gap-1.5 flex-wrap">
                      {step.tags.map((tag: string) => (
                        <span class="text-[10px] px-2 py-0.5 rounded bg-blue-950/40 text-blue-300 border border-blue-800/40 font-mono">{tag}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              
              <!-- BOUTON INTERACTIF : Injection des toolIds dans data-tools -->
              <button 
                class="playbook-action-btn w-full mt-6 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-sm font-semibold transition border border-slate-700"
                data-tools={JSON.stringify(playbook.toolIds)}
              >
                Importer dans ma Stack ↗
              </button>
            </div>
          ))}
        </div>
      </section>

    </main>

    <!-- MODALES -->
    <div id="details-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl relative">
        <button id="close-details-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2">✕</button>
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <span id="modal-cat-badge" class="text-xs font-mono px-2.5 py-0.5 bg-slate-800 text-slate-300 rounded-full">--</span>
          <span id="modal-apptype-badge" class="text-xs font-mono px-2.5 py-0.5 bg-purple-950/40 text-purple-300 border border-purple-800/40 rounded-full">--</span>
        </div>
        <h2 id="modal-title" class="text-2xl font-bold text-white mb-3">Titre Outil</h2>
        <p id="modal-desc" class="text-sm text-slate-300 leading-relaxed mb-6">Description détaillée...</p>
        <div class="flex items-center justify-between pt-4 border-t border-slate-800">
          <button id="modal-stack-toggle" class="text-xs font-semibold px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition flex items-center gap-1.5">
            📦 <span>Ajouter Stack</span>
          </button>
          <div class="flex items-center gap-3">
            <a id="modal-visit-btn" href="#" target="_blank" class="px-5 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-semibold transition flex items-center gap-1.5">Visiter ↗</a>
          </div>
        </div>
      </div>
    </div>

    <div id="stack-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-3xl w-full p-6 shadow-2xl relative max-h-[90vh] flex flex-col">
        <button id="close-stack-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2">✕</button>
        <h2 class="text-2xl font-bold text-white mb-2 flex items-center gap-2">📦 Ma Stack / Mon Kit</h2>
        <p class="text-sm text-slate-400 mb-6">Gérez votre sélection d'outils, exportez-la pour Obsidian ou partagez-la via un lien unique.</p>
        
        <div id="stack-list" class="flex-grow overflow-y-auto space-y-3 mb-6 pr-2"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 border-t border-slate-800">
          <button id="export-md-btn" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-sm font-semibold transition flex items-center justify-center gap-2 border border-slate-700">
            📝 Copier Markdown
          </button>
          <button id="share-url-btn" class="px-4 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-sm font-semibold transition flex items-center justify-center gap-2 shadow-lg shadow-blue-500/20">
            🔗 Copier Lien de Partage
          </button>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 flex items-center gap-3 px-4 py-3 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl text-xs font-medium text-white transition-all duration-300 opacity-0 translate-y-10 pointer-events-none">
      <span id="toast-icon">✅</span> <span id="toast-message">Action effectuée</span>
    </div>

    <script id="vault-tools-data" type="application/json" set:html={JSON.stringify(enrichedTools)}></script>

    <script>
      import Fuse from 'fuse.js';

      const rawData = document.getElementById('vault-tools-data')?.textContent || '[]';
      const tools = JSON.parse(rawData);

      let selectedSource = 'ALL';
      let selectedCat = 'ALL';
      let selectedDeploy = 'ALL';
      let showOnlyFavs = false; // Corrigé : réactivé !
      let displayLimit = 60;
      let filteredToolsCache = [...tools];

      let favorites = JSON.parse(localStorage.getItem('vault_favs') || '[]');
      let stack = JSON.parse(localStorage.getItem('vault_stack') || '[]');

      const fuse = new Fuse(tools, { keys: ['title', 'cleanCategory', 'safeDesc', 'appType'], threshold: 0.35 });
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const activeFilterInd = document.getElementById('active-filter-indicator');
      const filterNameText = document.getElementById('filter-name-text');

      // Import URL Stack
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('stack')) {
        try {
          const decoded = atob(urlParams.get('stack')!);
          const importedIds = decoded.split(',').map(Number).filter(n => !isNaN(n));
          stack = [...new Set([...stack, ...importedIds])];
          localStorage.setItem('vault_stack', JSON.stringify(stack));
          window.history.replaceState({}, document.title, window.location.pathname);
          setTimeout(() => showToast(`${importedIds.length} outils importés dans votre Stack !`, "📦"), 500);
        } catch(e) {}
      }

      function showToast(msg: string, icon = '✅') {
        const t = document.getElementById('toast');
        if (!t) return;
        document.getElementById('toast-icon')!.textContent = icon;
        document.getElementById('toast-message')!.textContent = msg;
        t.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
        setTimeout(() => t.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none'), 2500);
      }

      function updateBadgesUI() {
        document.getElementById('fav-badge')!.textContent = favorites.length.toString();
        document.getElementById('stack-badge')!.textContent = stack.length.toString();
        
        document.querySelectorAll('.fav-btn').forEach(btn => {
          const id = Number(btn.getAttribute('data-id'));
          btn.classList.toggle('text-yellow-400', favorites.includes(id));
          btn.classList.toggle('text-slate-600', !favorites.includes(id));
        });

        document.querySelectorAll('.stack-btn').forEach(btn => {
          const id = Number(btn.getAttribute('data-id'));
          btn.classList.toggle('text-blue-400', stack.includes(id));
          btn.classList.toggle('text-slate-600', !stack.includes(id));
        });
      }

      function filterAndDisplay() {
        const query = searchInput?.value.trim();
        let matched = query ? fuse.search(query).map(r => r.item) : [...tools];

        matched = matched.filter(t => {
          if (selectedSource !== 'ALL' && t.source !== selectedSource) return false;
          if (selectedCat !== 'ALL' && t.cleanCategory !== selectedCat) return false;
          
          // CORRECTION : Filtrage des favoris réactivé
          if (showOnlyFavs && !favorites.includes(t.id)) return false; 
          
          if (selectedDeploy !== 'ALL') {
            if (selectedDeploy === 'API' && !t.requiresApi) return false;
            if (selectedDeploy === 'Self-Hosted' && (!t.appType?.toLowerCase().includes('self-hosted') && !t.safeDesc.toLowerCase().includes('docker'))) return false;
            if (selectedDeploy === 'CLI' && !t.appType?.toLowerCase().includes('cli')) return false;
            if (selectedDeploy === 'Web' && t.appType?.toLowerCase().includes('cli')) return false; 
          }
          return true;
        });

        const sortVal = (document.getElementById('sort-select') as HTMLSelectElement)?.value;
        if (sortVal === 'az') matched.sort((a, b) => a.title.localeCompare(b.title));
        if (sortVal === 'za') matched.sort((a, b) => b.title.localeCompare(a.title));

        filteredToolsCache = matched;
        document.getElementById('counter-num')!.textContent = matched.length.toString();

        const visibleIds = new Set(matched.slice(0, displayLimit).map(t => t.id));
        document.querySelectorAll('.tool-card').forEach((card: any) => {
          const id = Number(card.getAttribute('data-id'));
          card.style.display = visibleIds.has(id) ? 'flex' : 'none';
        });

        // Gestion de l'indicateur de filtre actif
        if (activeFilterInd && filterNameText) {
          if (showOnlyFavs) {
            activeFilterInd.classList.remove('hidden');
            filterNameText.textContent = '⭐ Mes Favoris';
          } else if (selectedCat !== 'ALL') {
            activeFilterInd.classList.remove('hidden');
            filterNameText.textContent = `${selectedSource === 'free_for_dev' ? 'Free Dev' : 'OSINT'} > ${selectedCat}`;
          } else {
            activeFilterInd.classList.add('hidden');
          }
        }
      }

      // CORRECTION : Bouton SURPRENEZ-MOI !
      function triggerRandomTool() {
        const pool = filteredToolsCache.length > 0 ? filteredToolsCache : tools;
        if (!pool || pool.length === 0) return;
        const randomTool = pool[Math.floor(Math.random() * pool.length)];
        
        document.getElementById('modal-title')!.textContent = randomTool.title;
        document.getElementById('modal-desc')!.textContent = randomTool.safeDesc;
        (document.getElementById('modal-visit-btn') as HTMLAnchorElement).href = randomTool.url;
        
        const detailsModal = document.getElementById('details-modal');
        detailsModal?.classList.remove('hidden');
        setTimeout(() => detailsModal?.classList.remove('opacity-0'), 10);
        showToast(`Outil au hasard : ${randomTool.title}`, "🎲");
      }
      document.getElementById('btn-surprise-nav')?.addEventListener('click', triggerRandomTool);

      // CORRECTION : Écouteur pour le bouton Favoris de la Navbar
      document.getElementById('btn-fav-toggle')?.addEventListener('click', () => {
        showOnlyFavs = !showOnlyFavs;
        displayLimit = 60;
        document.getElementById('tab-tools')?.click(); // Force le retour sur l'onglet catalogue
        filterAndDisplay();
      });

      // Bouton Réinitialiser le filtre
      document.getElementById('reset-filter-btn')?.addEventListener('click', () => {
        selectedSource = 'ALL';
        selectedCat = 'ALL';
        showOnlyFavs = false;
        if (searchInput) searchInput.value = '';
        displayLimit = 60;
        filterAndDisplay();
      });

      // GESTION DES ONGLETS
      document.getElementById('tab-tools')?.addEventListener('click', (e) => {
        document.getElementById('section-tools')?.classList.remove('hidden');
        document.getElementById('search-container')?.classList.remove('hidden');
        document.getElementById('section-playbooks')?.classList.add('hidden');
        e.currentTarget.classList.add('active', 'bg-slate-800', 'text-white', 'border-slate-700');
        e.currentTarget.classList.remove('text-slate-400', 'border-transparent');
        document.getElementById('tab-playbooks')?.classList.remove('active', 'bg-slate-800', 'text-white', 'border-slate-700');
        document.getElementById('tab-playbooks')?.classList.add('text-slate-400', 'border-transparent');
      });

      document.getElementById('tab-playbooks')?.addEventListener('click', (e) => {
        document.getElementById('section-playbooks')?.classList.remove('hidden');
        document.getElementById('section-tools')?.classList.add('hidden');
        document.getElementById('search-container')?.classList.add('hidden');
        e.currentTarget.classList.add('active', 'bg-slate-800', 'text-white', 'border-slate-700');
        e.currentTarget.classList.remove('text-slate-400', 'border-transparent');
        document.getElementById('tab-tools')?.classList.remove('active', 'bg-slate-800', 'text-white', 'border-slate-700');
        document.getElementById('tab-tools')?.classList.add('text-slate-400', 'border-transparent');
      });

      // PLAYBOOKS : Ajouter les outils à la stack
      document.querySelectorAll('.playbook-action-btn').forEach(btn => {
        btn.addEventListener('click', (e: any) => {
          const rawIds = e.currentTarget.getAttribute('data-tools');
          if (!rawIds) return;
          const idsToImport = JSON.parse(rawIds);
          
          let addedCount = 0;
          idsToImport.forEach((id: number) => {
            if (!stack.includes(id)) {
              stack.push(id);
              addedCount++;
            }
          });

          if (addedCount > 0) {
            localStorage.setItem('vault_stack', JSON.stringify(stack));
            updateBadgesUI();
            showToast(`${addedCount} outil(s) du Playbook ajoutés !`, "🚀");
          } else {
            showToast("Ces outils sont déjà dans votre Stack.", "ℹ️");
          }
          
          // Ouvre la modale de Stack pour montrer le résultat
          document.getElementById('btn-stack-toggle')?.click();
        });
      });

      document.querySelectorAll('.quick-chip, .nav-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const src = btn.getAttribute('data-source');
          const cat = btn.getAttribute('data-cat');
          if (src) selectedSource = src;
          if (cat) selectedCat = cat;
          showOnlyFavs = false; displayLimit = 60;
          document.querySelectorAll('.quick-chip').forEach(c => c.classList.remove('active', 'border-blue-500'));
          if (btn.classList.contains('quick-chip')) btn.classList.add('active');
          document.getElementById('tab-tools')?.click();
          filterAndDisplay();
        });
      });

      document.querySelectorAll('.deploy-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          selectedDeploy = btn.getAttribute('data-deploy') || 'ALL';
          document.querySelectorAll('.deploy-chip').forEach(c => {
            c.classList.remove('active', 'bg-blue-900/30', 'border-blue-800/50', 'text-blue-300');
            c.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-400');
          });
          btn.classList.add('active', 'bg-blue-900/30', 'border-blue-800/50', 'text-blue-300');
          btn.classList.remove('bg-slate-900', 'border-slate-800', 'text-slate-400');
          displayLimit = 60; filterAndDisplay();
        });
      });

      searchInput?.addEventListener('input', () => { displayLimit = 60; filterAndDisplay(); });
      document.getElementById('sort-select')?.addEventListener('change', () => { displayLimit = 60; filterAndDisplay(); });
      document.getElementById('load-more-btn')?.addEventListener('click', () => { displayLimit += 60; filterAndDisplay(); });

      document.getElementById('tools-grid')?.addEventListener('click', (e: any) => {
        const target = e.target;
        if (target.classList.contains('fav-btn')) {
          e.stopPropagation();
          const id = Number(target.getAttribute('data-id'));
          if (favorites.includes(id)) {
            favorites = favorites.filter((f: number) => f !== id);
            showToast("Retiré des favoris", "🗑️");
          } else {
            favorites.push(id);
            showToast("Ajouté aux favoris", "⭐");
          }
          localStorage.setItem('vault_favs', JSON.stringify(favorites));
          updateBadgesUI(); if (showOnlyFavs) filterAndDisplay(); return;
        }
        
        if (target.classList.contains('stack-btn')) {
          e.stopPropagation();
          const id = Number(target.getAttribute('data-id'));
          if (stack.includes(id)) {
            stack = stack.filter((s: number) => s !== id);
            showToast("Retiré de la stack", "📦");
          } else {
            stack.push(id);
            showToast("Ajouté à la stack", "📦");
          }
          localStorage.setItem('vault_stack', JSON.stringify(stack));
          updateBadgesUI(); return;
        }

        const card = target.closest('.tool-card');
        if (card && !target.closest('.visit-btn')) {
          const id = Number(card.getAttribute('data-id'));
          const tool = tools.find((t: any) => t.id === id);
          if (tool) {
            document.getElementById('modal-title')!.textContent = tool.title;
            document.getElementById('modal-desc')!.textContent = tool.safeDesc;
            (document.getElementById('modal-visit-btn') as HTMLAnchorElement).href = tool.url;
            document.getElementById('details-modal')?.classList.remove('hidden');
            setTimeout(() => document.getElementById('details-modal')?.classList.remove('opacity-0'), 10);
          }
        }
      });

      // MODALE STACK
      const stackModal = document.getElementById('stack-modal');
      const stackList = document.getElementById('stack-list');

      function renderStackModal() {
        if (!stackList) return;
        if (stack.length === 0) {
          stackList.innerHTML = `<div class="text-center text-slate-500 py-10">Votre stack est vide.</div>`;
          return;
        }
        stackList.innerHTML = stack.map(id => {
          const t = tools.find((x: any) => x.id === id);
          if (!t) return '';
          return `
            <div class="flex items-center justify-between p-3 bg-slate-950 border border-slate-800 rounded-xl mb-2">
              <div>
                <h4 class="text-sm font-semibold text-slate-200">${t.title}</h4>
                <p class="text-xs text-slate-500 truncate max-w-md">${t.safeDesc}</p>
              </div>
              <button class="remove-stack-item text-red-400 hover:text-red-300 text-xs px-2 py-1 bg-red-950/30 rounded" data-id="${id}">Retirer</button>
            </div>
          `;
        }).join('');
      }

      document.getElementById('btn-stack-toggle')?.addEventListener('click', () => {
        renderStackModal();
        stackModal?.classList.remove('hidden');
        setTimeout(() => stackModal?.classList.remove('opacity-0'), 10);
      });

      stackList?.addEventListener('click', (e: any) => {
        if (e.target.classList.contains('remove-stack-item')) {
          const id = Number(e.target.getAttribute('data-id'));
          stack = stack.filter((s: number) => s !== id);
          localStorage.setItem('vault_stack', JSON.stringify(stack));
          updateBadgesUI();
          renderStackModal();
        }
      });

      // EXPORTS
      document.getElementById('export-md-btn')?.addEventListener('click', () => {
        let md = `# Ma Stack de Développement & OSINT\n*Généré via Vault.dev*\n\n`;
        stack.forEach(id => {
          const t = tools.find((x: any) => x.id === id);
          if (t) md += `- **[${t.title}](${t.url})** : ${t.safeDesc}\n`;
        });
        navigator.clipboard.writeText(md);
        showToast("Markdown copié ! Prêt pour Obsidian.", "📝");
      });

      document.getElementById('share-url-btn')?.addEventListener('click', () => {
        if (stack.length === 0) return showToast("Stack vide !", "⚠️");
        const encoded = btoa(stack.join(','));
        const url = new URL(window.location.href);
        url.searchParams.set('stack', encoded);
        navigator.clipboard.writeText(url.toString());
        showToast("Lien de partage copié !", "🔗");
      });

      function closeAllModals() {
        document.querySelectorAll('.fixed.inset-0').forEach(m => {
          m.classList.add('opacity-0');
          setTimeout(() => m.classList.add('hidden'), 200);
        });
      }
      document.querySelectorAll('#close-details-modal, #close-stack-modal, #close-modal').forEach(btn => btn.addEventListener('click', closeAllModals));
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); searchInput?.focus(); searchInput?.select(); }
        else if (e.key === 'Escape') closeAllModals();
      });

      updateBadgesUI();
      filterAndDisplay();
    </script>
  </body>
</html>